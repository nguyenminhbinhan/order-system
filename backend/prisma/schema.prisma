// ==========================
// Prisma schema for BE_ORDER_SYSTEM
// ==========================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================

enum UserRole {
  customer
  service
  kitchen
  manager
  admin
}

enum UserStatus {
  active
  inactive
  suspended
  deleted
}

enum MenuItemStatus {
  active
  inactive
  deleted
}

enum ContractType {
  trial
  monthly
  yearly
  permanent
}

enum TableStatus {
  empty
  waiting_confirmation
  occupied
  needs_payment
}

enum OrderStatus {
  pending_confirmation
  pending
  confirmed
  preparing
  ready
  delivered
  cancelled
}

enum MessageSender {
  customer
  service
  system
}

enum OrderItemStatus {
  pending
  confirmed
  preparing
  ready
  cancelled
}

enum PaymentMethod {
  cash
  bank
  momo
  vnpay
}

enum PaymentStatus {
  pending
  paid
  failed
}

// ==========================
// MODELS
// ==========================

model User {
  id           String       @id @default(uuid())
  name         String
  role         UserRole
  phone        String?
  email        String?      @unique
  password     String
  contractType ContractType @default(monthly)
  address      String
  createdAt    DateTime     @default(now())
  menuItems    MenuItem[]
  auditLogs    AuditLog[]
  status       UserStatus   @default(active)
  isDeleted    Boolean      @default(false)
}

model Table {
  id        Int            @id @default(autoincrement())
  name      String
  qrCode    String
  qrToken   String         @unique @default(uuid())
  status    TableStatus    @default(empty)
  isLocked  Boolean        @default(false)
  orders    Order[]
  messages  Message[]
  sessions  TableSession[]
  isDeleted Boolean        @default(false)
}

model Category {
  id        String     @id @default(uuid())
  name      String
  sortOrder Int
  menuItems MenuItem[]
}

model MenuItem {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 0)
  available     Boolean        @default(true)
  categoryId    String?
  userId        String
  category      Category?      @relation(fields: [categoryId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]
  images        ImageItem[]
  options       OptionItem[]
  status        MenuItemStatus @default(active)
  isDeleted     Boolean        @default(false)
  imageFilename String?
}

model Order {
  id          String        @id @default(uuid())
  tableId     Int
  sessionId   String?
  status      OrderStatus   @default(pending)
  totalAmount Decimal
  createdAt   DateTime      @default(now())
  isStaff     Boolean       @default(false)
  table       Table         @relation(fields: [tableId], references: [id])
  session     TableSession? @relation(fields: [sessionId], references: [id])
  items       OrderItem[]
  payments    Payment[]
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  price      Decimal
  quantity   Int             @default(1)
  note       String?
  status     OrderItemStatus @default(pending)
  order      Order           @relation(fields: [orderId], references: [id])
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
}

model Payment {
  id      String        @id @default(uuid())
  orderId String
  method  PaymentMethod
  amount  Decimal
  status  PaymentStatus @default(pending)
  paidAt  DateTime?
  image   String?
  order   Order         @relation(fields: [orderId], references: [id])
}

model ImageItem {
  id     Int      @id @default(autoincrement())
  menuId String
  image  String
  menu   MenuItem @relation(fields: [menuId], references: [id])
}

model OptionItem {
  id       Int      @id @default(autoincrement())
  menuId   String
  name     String
  required Boolean  @default(false)
  menu     MenuItem @relation(fields: [menuId], references: [id])
}

model Message {
  id        String        @id @default(uuid())
  tableId   Int
  sender    MessageSender
  content   String
  createdAt DateTime      @default(now())

  table Table @relation(fields: [tableId], references: [id])
}

model TableSession {
  id          String    @id @default(uuid())
  tableId     Int
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  totalAmount Decimal   @default(0)
  billPrinted Boolean   @default(false)
  paidAt      DateTime?
  billSnapshot Json?

  table  Table   @relation(fields: [tableId], references: [id])
  orders Order[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  tableId   Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}
